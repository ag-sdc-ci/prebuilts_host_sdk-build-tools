package {
    default_applicable_licenses: ["prebuilts_host_sdk-build-tools_license"],
}

license {
    name: "prebuilts_host_sdk-build-tools_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_prebuilt_binary {
    name: "aapt",
    srcs: ["bin/aapt"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "aapt2",
    srcs: ["bin/aapt2"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

