    name: "llvm-rs-cc",
    srcs: ["bin/llvm-rs-cc"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

java_import {
    name: "core-lambda-stubs",
    jars: ["lib/core-lambda-stubs.jar"],
    host_supported: true,
}
