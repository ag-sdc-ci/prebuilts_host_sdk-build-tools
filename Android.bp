    srcs: ["bin/split-select"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "zipalign",
    srcs: ["bin/zipalign"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
